# Copy this file to `.env` (same directory) and fill in your real values.
#
#   cp .env.example .env
#
# `.env` itself is gitignored — only this `.example` file is ever committed.
# Never commit your real `.env`, never bake it into a Dockerfile/image.
#
# The build.sh wizard asks for this file's *path* and a Kubernetes Secret
# name — never its contents — then reminds you to run:
#   kubectl -n <namespace> create secret generic <name> --from-env-file=.env
# which is the only place these values should ever be typed.

HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Add whatever else your own script/job needs — any KEY=value line here
# becomes an environment variable in the container once the Secret is
# created and referenced via `envFrom`.
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
